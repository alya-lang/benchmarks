let key: int[] = [83, 101, 99, 114, 101, 116, 65, 108, 121, 97, 75, 101, 121, 50, 48, 50, 54]
let key_len: int = len(key)

let s: int[] = []
let k: int = 0
while k < 256
    s.push(k)
    k += 1
end

let j: int = 0
let i: int = 0
while i < 256
    j = (j + s[i] + key[i % key_len]) % 256
    let tmp: int = s[i]
    s[i] = s[j]
    s[j] = tmp
    i += 1
end

i = 0
j = 0
let checksum: int = 0
let n: int = 100000
let step: int = 0
while step < n
    i = (i + 1) % 256
    j = (j + s[i]) % 256
    let tmp2: int = s[i]
    s[i] = s[j]
    s[j] = tmp2
    let stream_byte: int = s[(s[i] + s[j]) % 256]
    let data_byte: int = (step * 31) % 256
    let cipher_byte: int = data_byte ^ stream_byte
    checksum += cipher_byte
    step += 1
end

say checksum
