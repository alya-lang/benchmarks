let total_in: int = 0
let seed: int = 42
let n: int = 500000
let i: int = 0
while i < n
    seed = (seed * 1103515245 + 12345) % 32768
    if seed < 0
        seed = -seed
    end
    let x: int = seed

    seed = (seed * 1103515245 + 12345) % 32768
    if seed < 0
        seed = -seed
    end
    let y: int = seed

    if x * x + y * y <= 1073741824
        total_in += 1
    end
    i += 1
end

say total_in
