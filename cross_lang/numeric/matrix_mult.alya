let n: int = 120
let a: int[] = []
let b: int[] = []
let c: int[] = []

let i: int = 0
while i < n
    let j: int = 0
    while j < n
        a.push((i * 3 + j) % 10)
        b.push((i * 7 + j) % 10)
        c.push(0)
        j += 1
    end
    i += 1
end

i = 0
while i < n
    let row_a: int = i * n
    let j: int = 0
    while j < n
        let sum: int = 0
        let k: int = 0
        let unroll_limit: int = n - 3
        while k < unroll_limit
            sum += (a[row_a + k] * b[k * n + j]) + (a[row_a + k + 1] * b[(k + 1) * n + j]) + (a[row_a + k + 2] * b[(k + 2) * n + j]) + (a[row_a + k + 3] * b[(k + 3) * n + j])
            k += 4
        end
        while k < n
            sum += a[row_a + k] * b[k * n + j]
            k += 1
        end
        c[row_a + j] = sum
        j += 1
    end
    i += 1
end

let total: int = 0
let idx: int = 0
let total_cells: int = n * n
while idx < total_cells
    total += c[idx]
    idx += 1
end

say total
