function mandelbrot_point(cr: float, ci: float, max_iter: int) -> int
    let zr: float = 0.0
    let zi: float = 0.0
    let zr2: float = 0.0
    let zi2: float = 0.0
    let iter: int = 0
    while iter < max_iter
        zr2 = zr * zr
        zi2 = zi * zi
        if zr2 + zi2 > 4.0
            return iter
        end
        zi = 2.0 * zr * zi + ci
        zr = zr2 - zi2 + cr
        iter += 1
    end
    return max_iter
end

function compute_grid(width: int, height: int, max_iter: int) -> int
    let total: int = 0
    let y: int = 0
    let x: int = 0
    let iters: int = 0
    while y < height
        let ci: float = -1.5 + (3.0 * y) / height
        x = 0
        while x < width
            let cr: float = -2.0 + (3.0 * x) / width
            iters = mandelbrot_point(cr + 0.0, ci + 0.0, max_iter)
            total += iters
            x += 1
        end
        y += 1
    end
    return total
end

let total: int = compute_grid(200, 100, 200)
say total
