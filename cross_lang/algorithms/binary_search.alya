function binary_search(arr: int[], n: int, target: int) -> int
    let low: int = 0
    let high: int = n - 1
    while low <= high
        let mid = (low + high) / 2
        let val = arr[mid]
        when val
            is target => return mid
            is < target => low = mid + 1
            else => high = mid - 1
        end
    end
    return -1
end

let n: int = 100000
let arr: int[] = []
let i: int = 0
while i < n
    arr.push(i * 2)
    i += 1
end

let idx_sum: int = 0
let queries: int = 50000
let q: int = 0
while q < queries
    let target = (q * 3) % 200000
    let res = binary_search(arr, n, target)
    if res >= 0
        idx_sum += res
    end
    q += 1
end

say idx_sum
