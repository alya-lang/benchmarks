function count_primes(limit: int) -> int
    let flags: int[] = []
    let i: int = 0
    while i <= limit
        flags.push(true)
        i += 1
    end

    let p: int = 2
    while p * p <= limit
        if flags[p] == true
            let multiple: int = p * p
            while multiple <= limit
                flags[multiple] = false
                multiple += p
            end
        end
        p += 1
    end

    let count: int = 0
    let j: int = 2
    while j <= limit
        if flags[j] == true
            count += 1
        end
        j += 1
    end
    return count
end

let primes: int = count_primes(50000)
say primes
