function collatz_len(n)
    let steps = 0
    let cur = n
    while cur > 1
        cur = when cur % 2
            is 0 => cur / 2
            else => 3 * cur + 1
        end
        steps += 1
    end
    return steps
end

let max_len = 0
let i = 1
let limit = 100000
while i < limit
    let len = collatz_len(i)
    if len > max_len
        max_len = len
    end
    i += 1
end

say max_len
