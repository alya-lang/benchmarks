function collatz_len(n: int) -> int
    let steps: int = 0
    let cur: int = n
    while cur > 1
        cur = when cur % 2
            is 0 => cur / 2
            else => 3 * cur + 1
        end
        steps += 1
    end
    return steps
end

let max_len: int = 0
let i: int = 1
let limit: int = 100000
while i < limit
    let len: int = collatz_len(i)
    if len > max_len
        max_len = len
    end
    i += 1
end

say max_len
