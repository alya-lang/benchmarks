struct ListNode
    val: int
    next: ListNode?
end

let count: int = 50000
let head: ListNode? = null
let i: int = 0
while i < count
    head = ListNode { val: i, next: head }
    i += 1
end

let sum: int = 0
let cur: ListNode? = head
while cur is not null
    sum += cur.val
    cur = cur.next
end

say sum
